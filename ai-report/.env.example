APP_NAME=vulnagent-api
DEBUG=true

# Postgres: Celery 작업(Job) 상태를 저장하는 DB (jobs 테이블)
ASYNC_POSTGRESQL_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
SYNC_POSTGRESQL_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<db>

# RabbitMQ: Celery 브로커
CELERY_BROKER=amqp://<user>:<password>@<host>:5672//

# MySQL: 별도 수집 에이전트가 채워넣는 취약점 원본 데이터 (읽기 전용)
MYSQL_URL=mysql+pymysql://<user>:<password>@<host>:3306/<db>

# 위험 분석 콘텐츠를 영어로 생성하는 사이버보안 특화 로컬 LLM (llama.cpp 서빙)
LLM_BASE_URL=http://<host>:8080/v1
LLM_API_KEY=EMPTY
MODEL_NAME=LocalModel

# 영어 -> 한국어 번역 전용 모델 (translategemma)
TRANSLATE_LLM_BASE_URL=http://<host>:8081/v1
TRANSLATE_LLM_API_KEY=EMPTY
TRANSLATE_MODEL_NAME=translategemma

# RAG: 위협 인텔리전스(CTI) 벡터 검색
QDRANT_URL=http://<host>:6333
QDRANT_COLLECTION_NAME=Cyber-Threat-Intelligence
EMBEDDING_BASE_URL=http://<host>:8082/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL_NAME=bge-m3
