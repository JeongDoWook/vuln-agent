{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-push.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dev-stack.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__codelore__context_for_change",
      "mcp__codelore__constraints",
      "mcp__codelore__why",
      "mcp__codelore__history",
      "mcp__codelore__search"
    ]
  }
}
