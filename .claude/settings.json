          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dev-stack.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\APM\\Apache24\\htdocs\\codelore\\scripts\\codelore-guard.mjs\" --db \"C:\\APM\\Apache24\\htdocs\\codelore\\data\\codelore.db\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
