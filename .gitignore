# --- 비밀값 / 환경 ---
# 실제 env 파일은 커밋 금지. *.template 만 커밋한다.
.env
.env.dev
.env.prod
*.local

# 워크트리별 로컬 상태 — wt.sh add 가 그 트리의 기점 sha 를 여기 쓰고(153행),
#   sweep 이 "갓 만든 커밋 없는 브랜치"를 병합됐다고 오판하지 않게 쓴다(438행).
#   값이 트리마다 다르므로 **추적하면 안 된다** — 추적하던 동안엔 워크트리를 만드는 순간
#   ' M .wt-base-sha' 로 dirty 가 되어 `wt.sh rm` 이 "커밋되지 않은 변경" 으로 정리를 거부했다
#   (실측 2026-07-26: 워크트리 11개를 정리할 때마다 손으로 checkout 해서 되돌려야 했다).
.wt-base-sha

# Docker Secrets: 실제 비밀값 txt 는 커밋 금지. secrets/README.md 만 커밋.
secrets/*.txt

# 배포별 Caddy 루트 CA(공개 인증서지만 배포마다 다른 값 → 레포엔 안 넣는다). .gitkeep 만 커밋.
agent-ca/*.crt

# 에이전트 배포 대상 노드 목록. 비밀값은 아니지만 적히면 내부망 인벤토리가 된다
#   (이 저장소는 공개돼 있다). .template 만 커밋한다.
deploy/agent_nodes.txt

# 에이전트 자동 업데이트 서명용 Ed25519 개인키. 실수로도 커밋되면 안 된다 —
#   agent/README.md 체크리스트대로 홈 디렉터리(~/agent-signing.key)에만 두고 저장소 밖에 둔다.
*.key

# --- PHP ---
/vendor/
composer.lock

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- 에이전트 수집 결과물 ---
/data/
vulninv-*.json
vulninv-*.txt

# --- OMC / 로컬 상태 ---
.omc/

# --- review-kit 프로바이더 런타임 상태 (scripts/px.js) ---
# tracker=local 로 떨어졌을 때의 이슈 파일과 `px env up` 이 남기는 PID 기록.
# 머신마다 다른 값이라 추적하면 안 된다. 어댑터(.pipeline.json / .review-kit.json)와
# 설치 기록(.review-kit-manifest.json)은 2026-08-22 부터 아래 "대회 제출 저장소 정리"
# 섹션에서 개발 도구로 분류돼 통째로 untrack 됐다 — `kit-manifest.js check` 는 git
# 추적 여부와 무관하게 로컬 디스크 파일을 그대로 읽으므로 계속 동작한다.
.pipeline/
# px ws 가 작업공간에 얹는 상태 파일. wt/ 는 이미 통째로 무시되지만,
# 다른 위치에 작업공간을 만들 경우를 대비해 이름으로도 막는다.
.ws-state.json

# update.sh 의 배포 마커(마지막으로 배포에 성공한 커밋 SHA). 서버마다 다른 값이고,
#   무엇보다 추적하면 update.sh [1/6] 의 `git status --porcelain` 이 더러워져 배포 자체가 막힌다.
deploy/.deploy-state/

# 오케스트레이터 워커가 워크트리에 남기는 실행 파일. 커밋하지 않는다.
.initial-prompt
.launch.ps1

# --- wt 파이프라인: git worktree 작업 영역 (브랜치별 체크아웃) ---
# 각 worktree 는 별도 브랜치 체크아웃 + .pipe/ 산출물. main 에는 커밋하지 않는다.
/wt/

# --- OS / 에디터 ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# 로컬 전용 산출물: 브라우저 인증 상태(.playwright-auth)와 UI 감사 결과(.ui-audit).
# 지금은 빈 디렉터리지만 내용이 생기면 이 머신에서만 의미 있는 데이터다.
.playwright-auth/
.ui-audit/

# go_deps_extract_test.sh 임시 fixture(trap 정상 종료 시 자동 삭제 — 비정상 종료 대비 안전망)
tests/.tmp-go-deps.*
tests/.tmp-origin.*
tests/.tmp-pkg-origins.*
# update_sh_scenarios.sh 샌드박스(임시 git 저장소 + 스텁). trap 으로 정상 삭제되지만 안전망.
tests/.tmp-update-sh.*


# codelore 편집 훅 — 명령에 codelore 설치 경로(머신마다 다름)가 박히므로 저장소에 남기지 않는다.
#   Claude Code 는 .claude/settings.local.json(전역 gitignore)에, Codex 는 이 파일에 둔다.
#   저장소가 공유하는 것은 규약(AGENTS.md)과 에이전트 tools 목록까지다.
.codex/hooks/hooks.json

# --- 대회 제출 저장소 정리: 개발 도구는 git 추적에서만 뺀다(디스크엔 그대로 둔다) ---
# README "출품 범위" 표가 이미 이 경로들을 "개발 도구(출품작 아님)"로 명시했다. 완전히
# 지우면 이 저장소를 계속 워크트리+오케스트레이터 방식으로 개발하는 로컬 워크플로우 자체가
# 사라지므로, git 인덱스에서만 빼고(`git rm -r --cached`) 워킹트리 파일은 남긴다(2026-08-22).
# 새 워크트리에는 deploy/wt.sh 의 cmd_add() 가 메인 트리에서 이 경로들을 복사해 넣는다
# (secrets/*.txt 를 복사하던 것과 같은 패턴 — DEV_TOOL_PATHS 참고).
/kit/
/.claude/
/.codex/
/scripts/
/deploy/orchestrator/
/CLAUDE.md
/AGENTS.md
/AGENTS-review-kit.md
/.review-kit.json
/.review-kit-manifest.json
/.pipeline.json
