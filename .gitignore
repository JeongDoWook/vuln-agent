# --- 비밀값 / 환경 ---
# 실제 env 파일은 커밋 금지. *.template 만 커밋한다.
.env
.env.dev
.env.prod
*.local

# Docker Secrets: 실제 비밀값 txt 는 커밋 금지. secrets/README.md 만 커밋.
secrets/*.txt

# --- PHP ---
/vendor/
composer.lock

# --- Python (matcher-ai, 나중) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- 에이전트 수집 결과물 ---
/data/
vulninv-*.json
vulninv-*.txt

# --- OMC / 로컬 상태 ---
.omc/

# --- wt 파이프라인: git worktree 작업 영역 (브랜치별 체크아웃) ---
# 각 worktree 는 별도 브랜치 체크아웃 + .pipe/ 산출물. main 에는 커밋하지 않는다.
/wt/

# --- OS / 에디터 ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
