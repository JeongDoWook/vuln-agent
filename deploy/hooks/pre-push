#!/usr/bin/env bash
# =============================================================================
# pre-push — CLAUDE.md 검증 게이트 (php -l + bash -n + 마이그레이션 파일명 + tests/smoke.sh)
# =============================================================================
# 설치: git config core.hooksPath deploy/hooks   (compose_runner.sh init 이 해준다)
#   전에는 .git/hooks/pre-push 에 손으로 넣어 뒀는데, .git 은 git 이 추적하지 않는다.
#   즉 새로 clone 하면 게이트가 **아예 없었다** — 규칙은 CLAUDE.md 에 "강제" 라고 적혀
#   있는데 집행자가 그 PC 에만 있었다. 그래서 저장소 안으로 옮긴다.
#
# 왜 이렇게 짰는가:
#   - lint 는 컨테이너 php:8.3 으로 한다. 호스트 php 는 7.2 라 8.x 문법을 오탐한다.
#   - 파일 경로가 아니라 stdin 으로 넣는다. 컨테이너는 자기 트리의 server/ 를 마운트하므로,
#     경로로 lint 하면 남의 파일을 검사할 수 있다. stdin 이면 어떤 컨테이너를 쓰든 안전하다.
#   - 작업트리가 아니라 push 될 커밋의 내용(git show <sha>:<file>)을 검사한다.
#     커밋되지 않은 수정은 push 되지 않으므로 게이트 대상이 아니다.
#   - **스모크는 "이 트리 전용 컨테이너" 만 친다.** web+scheduler 는 워크트리별로 독립된
#     컨테이너명(vulnagent-web-dev-<워크트리>, 메인 트리는 접미사 없음)을 쓰므로 애초에
#     다른 트리 것과 겹치지 않는다 — 이 트리의 deploy/.env.dev 에서 WEB_PORT 를 읽어 자기
#     컨테이너와 source mount를 확인한다. 없거나 불응이면 required failure다. 다른 tree를
#     대신 검사해 초록불을 만들지 않는다.
#
# 대상 지정:
#   VG_SMOKE_BASE=http://localhost:PORT git push   이 트리의 대상 스택 포트를 직접 지정
# 필수 검사는 환경변수로 skip 하지 않는다. 긴급 우회는 로컬 훅을 끄는 별도 운영 판단이며,
# gate 결과를 성공으로 위장하지 않는다.
# =============================================================================
set -uo pipefail

ZERO=0000000000000000000000000000000000000000
fail=0

ROOT=$(git rev-parse --show-toplevel)

# --- 이 트리 전용 컨테이너가 떠 있나 ------------------------------------------
# web+scheduler 는 워크트리별로 독립된 컨테이너명을 쓴다(vulnagent-web-dev-<워크트리>,
#   메인 트리는 접미사 없음) — 애초에 다른 트리 것과 안 겹치므로 마운트 경로를 대조할
#   필요 없이 "이 트리 전용 컨테이너가 떠 있나" 만 보면 된다.
WT_NAME=""
if [ "$(basename "$(dirname "$ROOT")")" = "wt" ]; then
  WT_NAME="$(basename "$ROOT")"
fi
WEB=${VG_WEB_CONTAINER:-vulnagent-web-dev${WT_NAME:+-$WT_NAME}}

# 포트는 이 트리 자신의 deploy/.env.dev 에 있다(워크트리는 wt.sh add 가 만든 전용 파일,
#   메인 트리는 init 이 만든 공용 파일 — 둘 다 자기 자신을 읽으면 된다).
WEB_PORT=$(sed -n 's/^WEB_PORT=\([0-9]\+\).*/\1/p' "$ROOT/deploy/.env.dev" 2>/dev/null | head -1)
BASE=${VG_SMOKE_BASE:-http://localhost:${WEB_PORT:-8000}}

# --- push 대상 커밋이 건드린 파일 수집: "<sha>\t<path>" -----------------------
pairs=$(
  while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$ZERO" ] && continue                    # 브랜치 삭제 push
    if [ "$rsha" = "$ZERO" ]; then                       # 신규 브랜치
      base=$(git merge-base "$lsha" origin/main 2>/dev/null) || base=
    else
      base=$rsha
    fi
    if [ -n "$base" ]; then
      git diff --name-only --diff-filter=ACMR "$base" "$lsha" --
    else
      git ls-tree -r --name-only "$lsha"                 # base 못 찾으면 전량
    fi | sed "s|^|$lsha\t|"
  done | sort -u
)

if [ -z "$pairs" ]; then
  echo "pre-push: 검사할 변경 파일 없음 — 통과"
  exit 0
fi

# --- PHP lint 백엔드 선택 ----------------------------------------------------
# stdin 으로 넣으므로 어떤 php:8.3 이든 결과가 같다 → 내 컨테이너가 없으면 아무 것이나,
# 그것도 없으면 일회용 컨테이너, 마지막으로 호스트 php.
#
# **PHP 가 바뀐 push 에서만 백엔드를 고른다.** 예전엔 변경 파일 종류를 보기 전에 무조건
# 골랐고, 못 고르면 exit 1 이었다. 그래서 `.php` 가 한 개도 없는 push(문서·JS·JSON 만
# 바꾼 커밋)까지 Docker 데몬이 꺼져 있다는 이유로 막혔다 — 검사할 대상이 없는데 검사
# 도구가 없다고 막은 셈이다(2026-08-08 실측: review-kit 이식 커밋 110 파일, .php 0개,
# docker 미기동 → 차단). 게이트가 약해지지는 않는다: PHP 가 바뀌었으면 아래 조건이
# 참이 되어 예전과 똑같이 백엔드를 요구하고, 없으면 그대로 exit 1 이다.
php_backend=none
lint_container=""
if printf '%s\n' "$pairs" | grep -q '\.php$'; then
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx -- "$WEB"; then
    php_backend=container; lint_container="$WEB"
  elif other=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -m1 '^vulnagent-web-dev'); then
    php_backend=container; lint_container="$other"
  elif docker info >/dev/null 2>&1; then
    php_backend=docker_run
  fi

  if [ "$php_backend" = "none" ]; then
    echo "pre-push: ✗ 컨테이너가 떠있지 않고 docker도 없음 — dev 스택을 올리거나 docker를 설치하세요" >&2
    exit 1
  fi

  case $php_backend in
    container)  echo "pre-push: PHP lint = 컨테이너 $lint_container (8.3)" ;;
    docker_run) echo "pre-push: PHP lint = docker run php:8.3-cli (일회용)" ;;
  esac
else
  echo "pre-push: PHP 변경 없음 — lint 백엔드 불필요"
fi

php_lint() {  # stdin ← 파일 내용
  # 컨테이너가 살아있어도(running) 응답을 안 주는 상태(불응)면 exec/run 이 멈춘다 —
  # 파일 한 개당 상한을 둬서 lint 단계에서부터 push 가 무한 대기하지 않게 한다.
  case $php_backend in
    container)  timeout 10 docker exec -i -- "$lint_container" php -l ;;
    docker_run) timeout 10 docker run --rm -i php:8.3-cli php -l ;;
    *)          php -l ;;
  esac
}

# --- 파일별 검사 -------------------------------------------------------------
n_php=0 n_sh=0 n_mig=0
while IFS=$'\t' read -r sha path; do
  [ -n "${path:-}" ] || continue
  case $path in
    db/migrations/*.sql)
      # 파일명은 타임스탬프여야 한다(db/migrations/README.md).
      # 연번은 "다음 번호가 뭔지" 를 모두가 합의해야 성립하는데, 동시에 뜬 브랜치들은
      # 각자 origin/main 을 보고 같은 번호를 집는다 — 실제로 두 번 터졌다(0003·0014 가 각각 두 개).
      # 규칙은 CLAUDE.md 에 있었지만 집행자가 없어서, 다음 사람이 관성으로 0021 을 이어 쓰기
      # 딱 좋은 상태였다. 여기서 막는다.
      #
      # **origin/main 에 이미 있는 파일은 검사하지 않는다.** 기존 연번 파일(0001…0020)은 그대로 두고
      # (사전순이라 옛 것이 먼저 돈다), 이 브랜치가 새로 만든 것만 본다. 신규 브랜치라 base 를 못 찾아
      # 전량 목록이 들어와도 옛 파일이 걸리지 않는 건 이 조건 덕이다.
      if ! git cat-file -e "origin/main:$path" 2>/dev/null; then
        if [[ ${path##*/} =~ ^[0-9]{14}_.+\.sql$ ]]; then
          n_mig=$((n_mig + 1))
        else
          echo "✗ 마이그레이션 파일명이 타임스탬프가 아님  $path" >&2
          echo "    연번(0001…)은 동시 브랜치끼리 같은 번호를 집어 충돌한다." >&2
          echo "    이렇게 바꾼다:  git mv \"$path\" db/migrations/\$(date +%Y%m%d%H%M%S)_이름.sql" >&2
          fail=1
        fi
      fi
      ;;
    *.php)
      if out=$(git show "$sha:$path" | php_lint 2>&1); then
        n_php=$((n_php + 1))
      else
        echo "✗ php -l  $path" >&2
        printf '%s\n' "$out" | sed 's/^/    /' >&2
        fail=1
      fi
      ;;
    *.sh|*/hooks/pre-push)
      if out=$(git show "$sha:$path" | bash -n 2>&1); then
        n_sh=$((n_sh + 1))
      else
        echo "✗ bash -n  $path" >&2
        printf '%s\n' "$out" | sed 's/^/    /' >&2
        fail=1
      fi
      ;;
  esac
done <<< "$pairs"

echo "pre-push: php -l ${n_php}개 통과, bash -n ${n_sh}개 통과, 신규 마이그레이션 ${n_mig}개 파일명 통과"

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: ✗ lint 실패 — push 중단" >&2
  exit 1
fi

# --- 공통 운영 게이트 -------------------------------------------------------
# Docker/현재 tree stack/HTTP/migration/smoke 판정은 중앙 검증과 같은 manifest/runner가 한다.
# required dependency가 없으면 그 뒤 check도 명시적 fail로 JSON에 남으며 non-zero로 끝난다.
echo "pre-push: 공통 운영 게이트 실행 ($BASE${WT_NAME:+ · wt/$WT_NAME})"
if ! bash deploy/run-gates.sh --profile pre-push --base "$BASE" --json; then
  echo "pre-push: ✗ 필수 운영 게이트 실패 — push 중단" >&2
  exit 1
fi

echo "pre-push: ✓ 게이트 통과"
exit 0
