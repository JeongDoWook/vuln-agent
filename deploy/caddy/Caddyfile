# Caddy 리버스 프록시 — vuln-agent 앞단 TLS 종료.
#   Let's Encrypt 인증서를 DuckDNS DNS-01 챌린지로 발급 → 인바운드 80/443 불필요.
#   Caddy 가 https 를 받아 내부 web:80(Apache/PHP) 으로 프록시한다.

ost-server.duckdns.org {
	encode gzip

	# 정식 인증서: Let's Encrypt(무료) 를 DuckDNS DNS-01 챌린지로 발급 → 모든 클라이언트가 신뢰.
	#   이 도메인을 소유한 DuckDNS 계정 토큰이 secrets/duckdns_token.txt 에 있어야 한다(entrypoint 가
	#   DUCKDNS_TOKEN 으로 노출). 발급 실패로 문제가 생기면 이 블록을 `tls internal` 한 줄로 되돌리고
	#   caddy 를 재빌드하면 즉시 자체서명으로 복귀한다.
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
	}

	reverse_proxy web:80 {
		# 뒷단 PHP 가 원 프로토콜/호스트를 알도록 표준 헤더 전달.
		header_up X-Forwarded-Proto https
	}
}
