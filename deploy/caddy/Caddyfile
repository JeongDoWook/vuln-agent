# Caddy 리버스 프록시 — vuln-agent 앞단 TLS 종료.
#   Let's Encrypt 인증서를 DuckDNS DNS-01 챌린지로 발급 → 인바운드 80/443 불필요.
#   Caddy 가 https 를 받아 내부 web:80(Apache/PHP) 으로 프록시한다.
#
# 사이트 주소는 환경변수 PROD_DOMAIN 으로 받는다(.env.prod → compose.prod.yml → 이 파일).
#   **기본값을 일부러 주지 않는다.** {$PROD_DOMAIN:localhost} 처럼 폴백을 두면 변수가 빠졌을 때
#   엉뚱한 이름으로 조용히 떠서 TLS 가 그 이름으로 발급되고, HTTPS 가 깨진 걸 아무도 모른다.
#   폴백이 없으면 빈 주소가 되어 Caddy 가 기동 자체를 거부한다 — 시끄럽게 죽는 쪽이 안전하다.
#     실측(caddy:2, `caddy validate`): PROD_DOMAIN 없음 → 주소가 빈 문자열이 되어 이 블록이
#     사이트가 아닌 **전역 옵션 블록**으로 파싱된다 → "unrecognized global option: encode" +
#     종료코드 1. 있음(example.test) → "Valid configuration" + 종료코드 0. 둘 다 실측 확인.

{$PROD_DOMAIN} {
	encode gzip

	# [현재] 자체서명(Caddy 내부 CA). 토큰/도메인소유 불필요, 즉시 HTTPS(브라우저 경고 뜸).
	tls internal

	# [정식으로 전환 시] 위 한 줄을 지우고 아래 블록으로 교체.
	#   단, 이 도메인을 소유한 DuckDNS 계정의 토큰이 secrets/duckdns_token.txt 에 있어야 함.
	#   ⚠ 2026-07-12 전환 시도 실패: DuckDNS 가 KO 반환(토큰이 이 도메인 계정 게 아님) →
	#     Caddy 가 cert 를 못 받아 HTTPS 다운. 올바른 토큰 확인 전엔 다시 켜지 말 것.
	# tls {
	# 	dns duckdns {env.DUCKDNS_TOKEN}
	# }

	reverse_proxy web:80 {
		# 뒷단 PHP 가 원 프로토콜/호스트를 알도록 표준 헤더 전달.
		header_up X-Forwarded-Proto https
		# PHP 컨테이너의 REMOTE_ADDR 는 항상 Docker 프록시 주소다. Caddy가 직접 본
		# 접속 원본만 별도 헤더로 덮어써서 클라이언트가 위조한 전달 헤더와 구분한다.
		header_up X-Real-IP {remote_host}
	}
}
