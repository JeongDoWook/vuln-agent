# =============================================================================
# vuln-agent · 운영 환경 변수 (템플릿, 비밀값 없음)
# =============================================================================
# 리눅스 서버에서 이 파일을 .env.prod 로 복사한다.  (또는 compose_runner.sh init)
# 비밀번호·토큰은 여기 두지 않는다 → secrets/*.txt (Docker Secrets)로 관리.
#   init 실행 시 secrets/*.txt 가 강한 랜덤값으로 자동 생성된다.
# .env.prod 는 절대 커밋하지 않는다(.gitignore). 이 .template 만 커밋.
# =============================================================================

# --- 이미지 버전 ---
MYSQL_VERSION=8.0

# --- MySQL (이름/DB명만. 비번은 secrets/ 로) ---
MYSQL_DATABASE=vulnagent
MYSQL_USER=vulnagent

# --- DB 데이터 저장 위치 ---
# 미설정 시 Docker named volume(db_data). 서버 디스크에 실제 폴더로 영속시키려면
# 절대경로 지정(down -v 에도 안전, 서버에서 파일로 확인 가능):
# 주의: 이 값이 안 실리면 named volume 으로 떨어져 빈 DB 가 뜬다.
#       반드시 compose_runner.sh 로 기동할 것(--env-file 주입).
DB_DATA=/apps/vulnagent/data/mysql

# --- 포트 ---
# 운영에서 DB 포트는 노출하지 않는다(compose.prod.yml). 웹 포트만.
WEB_PORT=8080

# --- 운영 도메인 (Caddy HTTPS 사이트 주소) ---
# deploy/caddy/Caddyfile 의 사이트 블록 주소({$PROD_DOMAIN})가 이 값을 그대로 쓴다.
# TLS 인증서도 이 이름으로 발급/서빙되므로, 실제로 접속하는 도메인과 정확히 같아야 한다.
# 주의: 이 값이 안 실리면 compose 가 caddy 기동을 거부한다(${PROD_DOMAIN:?…}).
#       설령 통과해도 Caddy 가 빈 주소를 전역 옵션 블록으로 읽어 기동에 실패한다
#       — 일부러 기본값을 두지 않았다. 조용히 엉뚱한 이름으로 뜨는 것보다 낫다.
PROD_DOMAIN=vulnagent.example.com

# --- 로그인 실패 제한/계정 잠금 (시크릿 아님) ---
#   지정 실패 횟수 초과 시 계정을 잠근다. 미설정 시 auth.php 기본값(5회/15분) 사용.
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_MINUTES=15
