# =============================================================================
# vuln-agent · 개발 환경 변수 (템플릿, 비밀값 없음)
# =============================================================================
# 이 파일을 .env.dev 로 복사한다.  (compose_runner.sh init 이 자동 복사)
# 비밀번호·토큰은 여기 두지 않는다 → secrets/*.txt (Docker Secrets)로 관리.
# .env.dev 는 git 에 커밋하지 않는다(.gitignore). 이 .template 만 커밋.
# =============================================================================

# --- 이미지 버전 ---
MYSQL_VERSION=8.0

# --- MySQL (이름/DB명만. 비번은 secrets/ 로) ---
MYSQL_DATABASE=vulnagent
MYSQL_USER=vulnagent

# --- DB 데이터 저장 위치 (named volume 대신 서버/PC 실폴더에 바인드마운트) ---
#   상대경로는 compose 파일(deploy/) 기준(../data/mysql = htdocs/vuln-agent/data/mysql). /data/ 는 gitignore.
DB_DATA=../data/mysql

# --- 포트 (개발 PC에서 접근) ---
WEB_PORT=8080
DB_PORT=3307
