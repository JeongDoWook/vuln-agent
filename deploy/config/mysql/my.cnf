# =============================================================================
# vuln-agent · MySQL 경량 설정 (/etc/mysql/conf.d/zz-vulnagent.cnf)
# =============================================================================
# 소규모 중앙 수집 서버 기준. 대형 튜닝은 하지 않는다.
# (운영 규모가 커지면 innodb_buffer_pool_size 등을 서버 메모리에 맞춰 조정
#  → 2026-07-22: 데이터 디렉토리 6.8GB 로 성장해 256M 버퍼풀로는 워킹셋이 캐시에
#    안 들어가 iotop 상 mysqld 순간 읽기 438MB/s 급 스파이크 확인. 운영 서버는
#    RAM 15GB 를 Ray 클러스터와 공유(여유 1.5GB, buff/cache 8.7GB)라 과도하게
#    잡지 않고 2048M(2G) 로만 조정함)
[mysqld]
# --- 문자셋 ---
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# --- 타임존 (KST) ---
default_time_zone = '+09:00'

# --- 네트워크/보안 ---
skip-name-resolve          # 역DNS 조회 생략(접속 지연·의존 제거)
local_infile     = 0       # LOAD DATA LOCAL INFILE 비활성(보안)
max_connections  = 150     # 소규모 서버 기준

# --- InnoDB ---
innodb_buffer_pool_size      = 2048M  # 2026-07-22: 데이터셋 6.8GB 성장에 맞춰 256M->2G(운영 RAM 15GB 공유 감안)
innodb_flush_log_at_trx_commit = 1   # 커밋마다 동기화(안전 우선)

# --- binlog 만료 (2026-07-21 장애: my.cnf 미설정 → 기본값 30일 그대로 적용되어 ---
# --- binlog 79개(1.1GB x 79, 약 67GB) 누적 → 디스크 100% full → git pull/배포 전부 실패) ---
# replica 없고 PITR 도 안 씀(백업은 별도 mysqldump) → binlog 를 오래 들고 있을 이유가 없다.
binlog_expire_logs_seconds = 259200  # 3일

# --- 정렬 버퍼 (기본 256KB 는 필터정렬(ORDER BY FIELD + LEFT JOIN) 동시부하 시 1038 Out of sort memory 를 낸다) ---
sort_buffer_size      = 2M
read_rnd_buffer_size  = 2M

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
