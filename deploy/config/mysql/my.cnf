# =============================================================================
# vuln-agent · MySQL 경량 설정 (/etc/mysql/conf.d/zz-vulnagent.cnf)
# =============================================================================
# 소규모 중앙 수집 서버 기준. 대형 튜닝은 하지 않는다.
# (운영 규모가 커지면 innodb_buffer_pool_size 등을 서버 메모리에 맞춰 조정)
[mysqld]
# --- 문자셋 ---
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# --- 타임존 (KST) ---
default_time_zone = '+09:00'

# --- 네트워크/보안 ---
skip-name-resolve          # 역DNS 조회 생략(접속 지연·의존 제거)
local_infile     = 0       # LOAD DATA LOCAL INFILE 비활성(보안)
max_connections  = 150     # 소규모 서버 기준

# --- InnoDB (소규모 기본값) ---
innodb_buffer_pool_size      = 256M
innodb_flush_log_at_trx_commit = 1   # 커밋마다 동기화(안전 우선)

# --- 정렬 버퍼 (기본 256KB 는 필터정렬(ORDER BY FIELD + LEFT JOIN) 동시부하 시 1038 Out of sort memory 를 낸다) ---
sort_buffer_size      = 2M
read_rnd_buffer_size  = 2M

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
