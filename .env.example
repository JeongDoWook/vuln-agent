# 이 파일을 .env 로 복사한 뒤 값을 바꿔서 사용하세요.  (cp .env.example .env)
# .env 는 git에 커밋되지 않습니다(.gitignore).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-pw
MYSQL_DATABASE=vulnagent
MYSQL_USER=vulnagent
MYSQL_PASSWORD=change-me-app-pw

# --- 웹 / 수신(ingest) ---
# 브라우저로 접속할 웹 포트 (http://localhost:8080)
WEB_PORT=8080
# 에이전트↔서버 공유 인증 토큰. 에이전트 --token 값과 반드시 동일해야 함.
INGEST_TOKEN=change-me-shared-token
# 호스트에서 MySQL 을 직접 볼 때 쓰는 포트 (컨테이너 내부는 항상 3306)
DB_PORT=3307
