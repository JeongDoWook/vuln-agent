# =============================================================================
# vuln-agent · 운영 환경 변수 (템플릿)
# =============================================================================
# 리눅스 서버에서 이 파일을 .env.prod 로 복사해 강한 비밀값으로 채운다.
#   cp .env.prod.template .env.prod   (또는 ./compose_runner.sh init)
# .env.prod 는 절대 커밋하지 않는다(.gitignore). 이 .template 만 커밋.
# 강한 비밀값 생성 예:  openssl rand -base64 24
# =============================================================================

# --- 이미지 버전 ---
MYSQL_VERSION=8.0

# --- MySQL (반드시 강한 값으로 교체) ---
MYSQL_ROOT_PASSWORD=__CHANGE_ME_STRONG_ROOT__
MYSQL_DATABASE=vulnagent
MYSQL_USER=vulnagent
MYSQL_PASSWORD=__CHANGE_ME_STRONG_APP__

# --- 포트 ---
# 운영에서 DB 포트는 노출하지 않는다(compose.prod.yml). 웹 포트만.
WEB_PORT=8080

# --- 에이전트 ↔ 서버 공유 인증 토큰 (반드시 강한 랜덤값으로 교체) ---
INGEST_TOKEN=__CHANGE_ME_STRONG_TOKEN__
