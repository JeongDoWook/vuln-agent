<?xml version="1.0" encoding="utf-8"?>
<oval_definitions xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5"
                  xmlns:red-def="http://oval.mitre.org/XMLSchema/oval-definitions-5#linux">
  <definitions>
    <definition class="patch" id="oval:com.redhat.rhsa:def:20240001" version="1">
      <metadata>
        <title>RHSA-2024:0001: openssl security update (Important)</title>
        <reference ref_id="RHSA-2024:0001" ref_url="https://access.redhat.com/errata/RHSA-2024:0001" source="RHSA"/>
        <reference ref_id="CVE-2024-1111" ref_url="https://access.redhat.com/security/cve/CVE-2024-1111" source="CVE"/>
        <reference ref_id="CVE-2024-2222" ref_url="https://access.redhat.com/security/cve/CVE-2024-2222" source="CVE"/>
        <advisory from="secalert@redhat.com">
          <severity>Important</severity>
        </advisory>
      </metadata>
      <criteria operator="AND">
        <criterion comment="Red Hat Enterprise Linux 9 is installed" test_ref="oval:com.redhat.rhsa:tst:20240001900"/>
        <criteria operator="OR">
          <criterion comment="openssl is earlier than 0:3.0.7-24.el9_2" test_ref="oval:com.redhat.rhsa:tst:20240001001"/>
        </criteria>
      </criteria>
    </definition>

    <definition class="patch" id="oval:com.redhat.rhsa:def:20240002" version="1">
      <metadata>
        <title>RHSA-2024:0002: openssl security update (Important)</title>
        <reference ref_id="RHSA-2024:0002" ref_url="https://access.redhat.com/errata/RHSA-2024:0002" source="RHSA"/>
        <reference ref_id="CVE-2024-1111" ref_url="https://access.redhat.com/security/cve/CVE-2024-1111" source="CVE"/>
        <advisory from="secalert@redhat.com">
          <severity>Important</severity>
        </advisory>
      </metadata>
      <criteria operator="AND">
        <criterion comment="openssl is earlier than 0:3.0.7-27.el9_4" test_ref="oval:com.redhat.rhsa:tst:20240002001"/>
      </criteria>
    </definition>
  </definitions>

  <tests>
    <!-- 플랫폼 검사: 상태에 EVR 이 없다 → 조치안이 아니므로 파서가 버려야 한다. -->
    <red-def:rpminfo_test check="at least one" comment="Red Hat Enterprise Linux 9 is installed"
                          id="oval:com.redhat.rhsa:tst:20240001900" version="1">
      <red-def:object object_ref="oval:com.redhat.rhsa:obj:20240001900"/>
      <red-def:state state_ref="oval:com.redhat.rhsa:ste:20240001900"/>
    </red-def:rpminfo_test>

    <red-def:rpminfo_test check="at least one" comment="openssl is earlier than 0:3.0.7-24.el9_2"
                          id="oval:com.redhat.rhsa:tst:20240001001" version="1">
      <red-def:object object_ref="oval:com.redhat.rhsa:obj:20240001001"/>
      <red-def:state state_ref="oval:com.redhat.rhsa:ste:20240001001"/>
    </red-def:rpminfo_test>

    <red-def:rpminfo_test check="at least one" comment="openssl is earlier than 0:3.0.7-27.el9_4"
                          id="oval:com.redhat.rhsa:tst:20240002001" version="1">
      <red-def:object object_ref="oval:com.redhat.rhsa:obj:20240001001"/>
      <red-def:state state_ref="oval:com.redhat.rhsa:ste:20240002001"/>
    </red-def:rpminfo_test>
  </tests>

  <objects>
    <red-def:rpminfo_object id="oval:com.redhat.rhsa:obj:20240001900" version="1">
      <red-def:name>redhat-release</red-def:name>
    </red-def:rpminfo_object>
    <red-def:rpminfo_object id="oval:com.redhat.rhsa:obj:20240001001" version="1">
      <red-def:name>openssl</red-def:name>
    </red-def:rpminfo_object>
  </objects>

  <states>
    <!-- 아키 검사만 있는 상태(EVR 없음) — 조치안이 아니다. -->
    <red-def:rpminfo_state id="oval:com.redhat.rhsa:ste:20240001900" version="1">
      <red-def:arch datatype="string" operation="pattern match">aarch64|x86_64</red-def:arch>
    </red-def:rpminfo_state>

    <red-def:rpminfo_state id="oval:com.redhat.rhsa:ste:20240001001" version="1">
      <red-def:evr datatype="evr_string" operation="less than">0:3.0.7-24.el9_2</red-def:evr>
    </red-def:rpminfo_state>

    <red-def:rpminfo_state id="oval:com.redhat.rhsa:ste:20240002001" version="1">
      <red-def:evr datatype="evr_string" operation="less than">0:3.0.7-27.el9_4</red-def:evr>
    </red-def:rpminfo_state>
  </states>
</oval_definitions>
