# =============================================================================
# vuln-agent · 개발 환경 변수 (템플릿)
# =============================================================================
# 이 파일을 .env.dev 로 복사해 값을 채운다.  (compose_runner.sh init 이 자동 복사)
# .env.dev 는 git 에 커밋되지 않는다(.gitignore). 이 .template 만 커밋.
# =============================================================================

# --- 이미지 버전 ---
MYSQL_VERSION=8.0

# --- MySQL ---
MYSQL_ROOT_PASSWORD=dev-root-pw
MYSQL_DATABASE=vulnagent
MYSQL_USER=vulnagent
MYSQL_PASSWORD=dev-app-pw

# --- 포트 (개발 PC에서 접근) ---
WEB_PORT=8080
DB_PORT=3307

# --- 에이전트 ↔ 서버 공유 인증 토큰 (에이전트 --token 과 동일해야 함) ---
INGEST_TOKEN=dev-shared-token
