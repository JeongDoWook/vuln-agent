        ' NULL 이면 shadow 미수집
        is_sudoer : bool
        is_system : bool
        pw_max_days : int
        last_login_at : datetime
        never_logged_in : bool
    }

    entity tb_package_dependency {
        package_dependency_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        container_id : bigint
