        setting_value : string
        description : string
    }
}

package "자산 탐색 — 관리 대역 스윕(섀도우 IT)" {

    ' 취약점 수집과 별개 파이프라인이다. 접점은 tb_discovered_asset.host_id 하나뿐.

    entity tb_discovery_target {
        discovery_target_id : bigint <<PK>>
        --
        cidr : string <<UK>>
        ports : string
        ' NULL = 기본 포트 세트
        label : string
        enabled : bool
        created_by : bigint
        ' tb_user.user_id - FK 없음(감사 관례)
    }

    entity tb_discovery_run {
        discovery_run_id : bigint <<PK>>
        --
        discovery_target_id : bigint <<FK>>
        status : enum
        ' pending running done failed
        started_at : datetime
        finished_at : datetime
        ip_total/ip_alive : int
        port_checked/open_total : int
        ' 닫힌 포트는 저장 안 함 - 집계로만
        elapsed_seconds : decimal
        error_text : text
    }

    entity tb_discovered_asset {
        discovered_asset_id : bigint <<PK>>
        --
        discovery_target_id : bigint <<FK>>
        ip : string
        ' UK(discovery_target_id, ip) - 대역 기준 누적
        hostname : string
        ' 역DNS(PTR). NULL = 이번에 못 찾음
        host_id : bigint <<FK>>
        ' NULL = 섀도우 IT 후보
        state : enum
        ' new known ignored
        first_seen : datetime
        last_seen : datetime
        last_run_id : bigint
    }

    entity tb_discovered_port {
        discovered_port_id : bigint <<PK>>
        --
        discovered_asset_id : bigint <<FK>>
        discovery_run_id : bigint <<FK>>
        port : int
        proto : string
        ' UK(asset, run, port, proto)
        service_hint : string
        ' 포트 관례에서 유추 - 추측이다
        banner : string
        ' HTTP Server 헤더 또는 TLS CN
    }
}

