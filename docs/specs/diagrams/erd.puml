@startuml erd
' vuln-agent §5 데이터 모델 (ERD)
' 원본: docs/dev/architecture.md §5
' 테이블별 전체 컬럼·책임·정규화 현황은 docs/dev/데이터베이스.md 참고.
'
' 범위: 도메인 엔티티 48개 전부(= 전체 49테이블 - tb_schema_migrations).
'      tb_schema_migrations 는 마이그레이션 러너 자신의 인프라 테이블이라 도메인 모델이 아니어서 뺐다.
'      영역이 한눈에 안 잡히던 문제는 package 로 묶어 해결한다(수집 / CVE / 벤더·기준 카탈로그 /
'      판정결과 / 운영).
'
' 표기: · 감사 4컬럼(created_at/updated_at/is_deleted/deleted_at)은 대부분의 테이블에 통일되어
'        있으나 이 다이어그램엔 생략한다(엔티티 39개에 4줄씩 붙으면 읽을 수 없다).
'      · 컬럼도 전부 적지 않는다 — PK/FK 와 그 테이블을 이해하는 데 필요한 것만.
'      · 실선(--)은 FK 가 실제로 걸린 관계, 점선(..)은 FK 없이 애플리케이션이 조인하는 관계다.
'
' 명명규칙: 테이블명은 단수, 대리키 PK 는 <단수 테이블명>_id, FK 는 부모 PK 이름을 그대로 쓴다
'          (tb_host.host_id ← tb_scan.host_id — 조인 양쪽 이름이 같다).
'          자연키·복합키·FK-as-PK 라 대리키를 두지 않는 예외(tb_cve/tb_kev_catalog 등)는
'          docs/dev/데이터베이스.md 의 예외표 참고.

hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 12
skinparam ranksep 22
skinparam packageStyle rectangle
skinparam package {
    BackgroundColor #f6f8fa
    BorderColor #adb5bd
    FontColor #57606a
}
skinparam entity {
    BackgroundColor #ffffff
    BorderColor #6e7681
}

package "수집·인벤토리 — 에이전트가 보내온 원본" {

    entity tb_host {
        host_id : bigint <<PK>>
        --
        fqdn : string <<UK>>
        os_id : string
        last_seen_ip : string
        poll_schedule_seconds : int
        grade_version : bigint
        is_deleted : bool
    }

    entity tb_asset_grade_review {
        host_id : bigint <<PK>><<FK>>
        --
        article9_item : enum
        article9_reference : string
        business_category : string
        data_category : string
        owning_department : string
        external_publication_state : enum
        review_reference : string
        next_review_date : date
        is_stale : bool
        review_version : bigint
        reviewed_by : bigint <<FK>>
        reviewed_at : datetime
    }

    entity tb_asset_grade_suggestion_history {
        suggestion_history_id : bigint <<PK>>
        --
        host_id : bigint <<FK>>
        scan_id : bigint <<FK>>
        suggested_grade : char
        ' 시스템 제안 - 확정값(tb_host.grade)이 아니다
        suggested_reason : string
        evaluation_status : enum
        ' SUGGESTED / NO_MATCH / NOT_EVALUATED
        evidence_snapshot : json
        result_fingerprint : binary <<UK>>
        last_observed_at : datetime
        effective_at : datetime
        ' 생성컬럼 - 관찰시각 기준 최대 7일까지만 과거로 클램프
    }

    entity tb_package_integrity {
        package_integrity_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        package_name : string
        flags : string
        ' rpm/dpkg 원본 플래그 그대로 (5=digest, M=권한, missing=없음)
        file_path : string
    }

    entity tb_scan {
        scan_id : bigint <<PK>>
        --
        host_id : bigint <<FK>>
        collected_at : datetime
        package_count : int
        exposure_count : int
        match_fingerprint : string
        ' 판정 결과 지문 - 같으면 재작성 안 함
        integrity_checked : bool
        integrity_partial : bool
        integrity_total : int
        ' 무결성 "검사 여부·부분결과·전체건수" 는 행이 아니라 스캔 단위 사실
        is_deleted : bool
    }

    entity tb_collection_stage {
        scan_id : bigint <<PK>><<FK>>
        stage_code : string <<PK>>
        ' 복합 자연키 - 명명규칙 예외
        --
        status : string
        ' MISSING 안 돌았음 / EMPTY 0건
        item_count : int
    }

    entity tb_scan_run {
        scan_run_id : bigint <<PK>>
        --
        host_id : bigint <<FK>>
        scan_id : bigint <<FK>>
        collected_at : datetime
        content_changed : bool
        elapsed_seconds : int
        peak_rss_mb : decimal
        cpu_seconds : decimal
    }

    entity tb_agent_command {
        agent_command_id : bigint <<PK>>
        --
        host_id : bigint <<FK>>
        run_at : datetime
        status : string
        progress_percent : int
        heartbeat_at : datetime
        cancel_requested_at : datetime
        cancelled_at : datetime
        is_deleted : bool
    }

    entity tb_package {
        package_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        container_id : bigint
        ' 호스트는 0, 컨테이너는 양수
        manager : string
        ' dpkg rpm apk pip npm
        name : string
        version : string
        source_pkg : string
        origin : string
        ' 출처 - 서드파티 판정
    }

    entity tb_container {
        container_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        cid : string
        image : string
        image_digest : string
        k8s_namespace : string
        os_id : string
        pkg_count : int
    }

    entity tb_exposure {
        exposure_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        proc : string
        port : int
        scope : string
        ' EXTERNAL LAN BOUND FILTERED LOCAL
        exe_pkg : string
        loaded_pkgs : text
    }

    entity tb_process {
        process_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        comm : string
        exe_pkg : string
        loaded_pkgs : text
    }

    entity tb_pkg_change {
        pkg_change_id : bigint <<PK>>
        --
        host_id : bigint <<FK>>
        scan_id : bigint <<FK>>
        package_name : string
        change_type : string
        ' installed removed upgraded downgraded
        old_version : string
        new_version : string
    }

    entity tb_host_account {
        host_account_id : bigint <<PK>>
        --
        host_id : bigint <<FK>>
        scan_id : bigint <<FK>>
        username : string
        ' UK(scan_id, username)
        uid : int
        shell : string
        is_locked : bool
        ' NULL 이면 shadow 미수집
        is_sudoer : bool
        is_system : bool
        pw_max_days : int
        last_login_at : datetime
        never_logged_in : bool
    }

    entity tb_package_dependency {
        package_dependency_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        container_id : bigint
        source : string
        ' sbom pom
        parent_manager/name/version : string
        ' 전부 NULL = 루트 표식·pom 직접선언
        child_manager/name/version : string
        edge_hash : binary(32)
        ' 생성컬럼 - UK(scan_id, container_id, edge_hash)
    }
}

package "CVE 도메인 — 검증된 피드에서 상속(스캔과 독립)" {

    entity tb_cve {
        cve_id : string <<PK>>
        ' 자연키 PK — 명명규칙 예외
        --
        cvss : decimal
        epss : decimal
        epss_percentile : decimal
        is_deleted : bool
    }

    entity tb_kev_catalog {
        cve_id : string <<PK>>
        ' FK-as-PK — 명명규칙 예외(대리키 없음)
        --
        date_added : date
        due_date : date
    }

    entity tb_cve_affected_package {
        cve_affected_package_id : bigint <<PK>>
        --
        cve_id : string
        ecosystem : string
        package_name : string
        fixed_version : string
        ' UK(cve_id, package_name, ecosystem)
    }

    entity tb_package_summary {
        package_name : string <<PK>>
        ecosystem : string <<PK>>
        ' 복합 자연키 - 명명규칙 예외
        --
        cve_cnt : int
        max_epss : decimal
        max_fixed : string
        ' 사전집계 - packages.php 전용
    }

    entity tb_package_license_summary {
        manager : string <<PK>>
        name : string <<PK>>
        license : string <<PK>>
        ' 복합 자연키 - 명명규칙 예외
        --
        risk : string
        pkg_count : int
        updated_at : datetime
        ' 사전집계 - packages.php?tab=lang 전용
    }

    entity tb_advisory {
        advisory_id : bigint <<PK>>
        --
        source : string
        title : string
        url : string <<UK>>
        published : date
        ' 관련 CVE 는 tb_advisory_cve 정션에만 있다(옛 cve_ids CSV 드롭)
        is_deleted : bool
    }

    entity tb_advisory_cve {
        advisory_cve_id : bigint <<PK>>
        --
        advisory_id : bigint <<FK>>
        cve_id : string
        ' UK(advisory_id, cve_id)
    }
}

package "벤더·기준 카탈로그 — 배포판·커널·보안설정 기준" {

    entity tb_debian_tracker {
        debian_tracker_id : bigint <<PK>>
        --
        release_codename : string
        pkg_name : string
        is_binary : bool
        cve_id : string
        fixed_version : string
        other_versions : string
        ' UK(release_codename, pkg_name, is_binary, cve_id)
    }

    entity tb_ubuntu_oval {
        ubuntu_oval_id : bigint <<PK>>
        --
        release_codename : string
        pkg_name : string
        cve_id : string
        fixed_version : string
        ' NULL 이면 아직 수정본 없음(조치 불가)
    }

    entity tb_vendor_errata {
        vendor_errata_id : bigint <<PK>>
        --
        vendor : string
        ' redhat almalinux
        release_major : string
        pkg_name : string
        cve_id : string
        fixed_evr : string
        advisory : string
    }

    entity tb_vendor_unfixed {
        vendor_unfixed_id : bigint <<PK>>
        --
        vendor : string
        release_major : string
        component : string
        ' 소스 패키지 단위
        cve_id : string
        fix_state : string
        ' 영향받음 고치지않음 조사중 지원종료
    }

    entity tb_kernel_cve {
        cve_id : string <<PK>>
        ' FK-as-PK — 명명규칙 예외
        --
        introduced_version : string
        mainline_fixed : string
    }

    entity tb_kernel_cve_fix {
        cve_id : string <<PK>><<FK>>
        stream : string <<PK>>
        ' 복합 자연키 - 명명규칙 예외
        --
        fixed_version : string
    }

    entity tb_compliance_rule {
        compliance_rule_id : bigint <<PK>>
        --
        rule_id : string <<UK>>
        ' SSG 룰 문자열 ID
        title : string
        severity : string
        refs_json : json
        ' CIS NIST STIG PCI-DSS 참조
    }

    entity tb_control_mapping {
        control_mapping_id : bigint <<PK>>
        --
        rule_code : string
        ' tb_cce_finding.code
        framework : string
        ' KISA_U ISMS_P N2SF
        control_id : string
        control_name : string
        ' UK(rule_code, framework, control_id)
    }

    entity tb_control_guide {
        control_guide_id : bigint <<PK>>
        --
        framework : string
        control_id : string
        ' UK(framework, control_id)
        description : text
        ' 이 통제가 무엇을 요구하는가
    }

    entity tb_cce_rule_guide {
        cce_rule_guide_id : bigint <<PK>>
        --
        rule_code : string <<UK>>
        summary : string
        remediation : text
        ' 조치 방법(파일·지시어 수준)
    }
}

package "판정 결과 — 우리 기여(런타임 상태·억제)" {

    entity tb_finding {
        finding_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        container_id : bigint
        cve_id : string
        package_name : string
        severity : string
        runtime_status : string
        ' EXTERNAL LISTENING RUNNING LOADED INSTALLED
        in_kev : bool
        no_fix : bool
        ' 벤더가 조치 불가로 확인
    }

    entity tb_finding_evidence {
        finding_id : bigint <<PK>><<FK>>
        ' FK-as-PK(1:1 확장) — 명명규칙 예외
        --
        match_source : string
        fixed_version : string
        source_package : string
        process_evidence : text
        network_evidence : text
        evidence_json : longtext
    }

    entity tb_suppressed_finding {
        suppressed_finding_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        cve_id : string
        package_name : string
        base_severity : string
        suppress_reason : string
    }

    entity tb_pkg_changelog_cve {
        pkg_changelog_cve_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        package_name : string
        cve_id : string
        evidence : string
    }

    entity tb_applied_errata {
        applied_errata_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        package_name : string
        cve_id : string
        evidence : string
        ' 권고가 지목한 설치 NEVRA
    }

    entity tb_debsecan {
        debsecan_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        cve_id : string
        package_name : string
    }

    entity tb_stale_lib {
        stale_lib_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        comm : string
        ' 옛 so 를 문 프로세스
        package_name : string
        lib_path : string
    }

    entity tb_cce_finding {
        cce_finding_id : bigint <<PK>>
        --
        scan_id : bigint <<FK>>
        code : string
        ssg_rule_id : string
        result : string
        ' PASS FAIL NA
        severity : string
    }

    entity tb_remediation_note {
        remediation_note_id : bigint <<PK>>
        --
        host_id : bigint <<FK>>
        cid : string
        ' 컨테이너 이름. '' = 호스트 자신
        cve_id : string
        package : string
        ' UK(host_id, cve_id, package, cid)
        reason : text
        ' 사람이 쓴 미조치 사유
        approved_by : bigint
        approved_at : datetime
        is_deleted : bool
    }

    entity tb_compliance_snapshot {
        compliance_snapshot_id : bigint <<PK>>
        --
        snapshot_date : date <<UK>>
        ' 판정 기준일 - 하루 1건
        taken_at : datetime
        is_deleted : bool
    }

    entity tb_compliance_snapshot_control {
        compliance_snapshot_control_id : bigint <<PK>>
        --
        compliance_snapshot_id : bigint <<FK>>
        control_key : string
        ' patch asset secops
        framework_ids : string
        status_label : string
        ' 준수 판정불가 부분준수 미준수
        violation_count : int
        unjudged_count : int
        evidence : json
    }
}

package "피드 운영 · 인증 · 감사" {

    entity tb_feed_connector {
        feed_connector_id : bigint <<PK>>
        --
        connector_type : string
        connection_json : json
        schedule_json : json
        enabled : bool
        next_run_at : datetime
        is_deleted : bool
    }

    entity tb_feed_collection_log {
        feed_collection_log_id : bigint <<PK>>
        --
        feed_connector_id : bigint <<FK>>
        status : string
        items_upserted : int
    }

    entity tb_user {
        user_id : bigint <<PK>>
        --
        username : string <<UK>>
        password_hash : string
        role : string
        is_deleted : bool
    }

    entity tb_role_permission {
        role_permission_id : int <<PK>>
        --
        role : string
        menu_code : string
        allowed : bool
    }

    entity tb_api_token {
        api_token_id : bigint <<PK>>
        --
        label : string
        token_hash : string <<UK>>
        token_prefix : string
        last_used_at : datetime
        is_deleted : bool
    }

    entity tb_agent_token {
        agent_token_id : bigint <<PK>>
        --
        host_fqdn : string
        token_hash : string <<UK>>
        is_revoked : bool
    }

    entity tb_agent_replay_nonce {
        agent_token_id : bigint <<PK>><<FK>>
        nonce_hash : string <<PK>>
        ' 복합 자연키 - 명명규칙 예외
        --
        expires_at : datetime
    }

    entity tb_activity_log {
        activity_log_id : bigint <<PK>>
        --
        user_id : bigint
        scope : string
        scope_id : bigint
        activity_type : string
        subject : string
        ' 처리 대상 자원 - ISMS-P 5요소
        action : string
        ' READ CREATE UPDATE DELETE EXPORT LOGIN EXECUTE OTHER
        data : json
        ip_address : string
    }

    entity tb_setting {
        setting_id : bigint <<PK>>
        --
        setting_key : string <<UK>>
        setting_value : string
        description : string
    }
}

' ── FK 가 실제로 걸린 관계 ────────────────────────────
tb_host ||--o{ tb_scan : "수집 이력"
tb_host ||--o{ tb_pkg_change : "패키지 변화 이력"
tb_host ||--o{ tb_scan_run : "실제 실행 이력"
tb_host ||--o{ tb_agent_command : "수집 명령"
tb_host ||--o{ tb_host_account : "계정 인벤토리"
tb_host ||--o{ tb_remediation_note : "미조치 사유 메모"
tb_host ||--o| tb_asset_grade_review : "최신 등급 검토"
tb_host ||--o{ tb_asset_grade_suggestion_history : "등급 제안 관찰 이력"

tb_scan ||--o{ tb_package : "설치 패키지"
tb_scan ||--o{ tb_exposure : "노출 소켓(포트)"
tb_scan ||--o{ tb_process : "실행 프로세스"
tb_scan ||--o{ tb_container : "컨테이너 인벤토리"
tb_scan ||--o{ tb_collection_stage : "수집 단계 완전성"
tb_scan ||--o{ tb_scan_run : "동일 스냅샷 재사용 가능"
tb_scan ||--o{ tb_finding : "매처 판정"
tb_scan ||--o{ tb_suppressed_finding : "억제된 건"
tb_scan ||--o{ tb_pkg_changelog_cve : "억제 근거②"
tb_scan ||--o{ tb_applied_errata : "억제 근거③"
tb_scan ||--o{ tb_debsecan : "억제 근거④"
tb_scan ||--o{ tb_stale_lib : "억제 취소 — 재시작 필요"
tb_scan ||--o{ tb_cce_finding : "보안설정 점검"
tb_scan ||--o{ tb_host_account : "그 스냅샷의 계정 목록"
tb_scan ||--o{ tb_package_dependency : "의존성 엣지(SBOM·pom)"
tb_scan ||--o{ tb_package_integrity : "원본과 다른 파일"
tb_scan ||--o{ tb_asset_grade_suggestion_history : "그 스캔의 제안 관찰"

tb_finding ||--o| tb_finding_evidence : "판정 근거(1:1)"
tb_compliance_snapshot ||--o{ tb_compliance_snapshot_control : "통제별 판정 결과"
tb_kernel_cve ||--o{ tb_kernel_cve_fix : "stable 시리즈별 조치버전"
tb_advisory ||--o{ tb_advisory_cve : "공지 ↔ CVE 정션"
tb_feed_connector ||--o{ tb_feed_collection_log : "수집 이력"
tb_user ||--o{ tb_api_token : "발급(Export API)"
tb_user |o--o{ tb_asset_grade_review : "등급 검토자"
tb_agent_token ||--o{ tb_agent_replay_nonce : "소진된 nonce"

' ── FK 없는 관계(점선) — 자연키 애플리케이션 조인 ─────
' CVE 도메인은 피드마다 수집 순서가 독립이라 FK 를 걸지 않는다(의도적 설계).
tb_cve ||..o{ tb_cve_affected_package : "영향 패키지"
tb_cve ||..o{ tb_finding : "취약점"
tb_cve ||..o| tb_kev_catalog : "KEV 등재"
tb_cve ||..o{ tb_advisory_cve : "CVE → 공지 역조회"
tb_cve_affected_package }o..|| tb_package_summary : "사전집계(OSV 실행 시 재생성)"
tb_container ||..o{ tb_package : "컨테이너 내부 패키지(container_id)"
tb_compliance_rule ||..o{ tb_cce_finding : "SSG 룰(ssg_rule_id)"
tb_cce_finding }o..o{ tb_control_mapping : "기준별 통제(rule_code = code)"
tb_control_mapping }o..o| tb_control_guide : "통제 설명(framework, control_id)"
tb_control_mapping }o..o| tb_cce_rule_guide : "룰 조치(rule_code)"
tb_remediation_note ||..o{ tb_finding : "자연키(host+cid+cve+package)로 붙는 사람 메모"

' 벤더 판정 소스는 매처가 참조만 한다(스캔에 매달리지 않음).
tb_debian_tracker }o..|| tb_finding : "데비안 백포트 판정"
tb_ubuntu_oval }o..|| tb_finding : "우분투 OVAL 판정"
tb_vendor_errata }o..|| tb_finding : "RHEL 계열 조치 EVR"
tb_vendor_unfixed }o..|| tb_finding : "조치 불가(no_fix)"
tb_kernel_cve }o..|| tb_finding : "커널 CVE 판정"

' ── 관계선을 두지 않은 테이블 ──────────────────────────
' tb_advisory       : CVE 와 느슨한 연계(제목의 CVE best-effort)라 FK 없음. 정본은 junction.
' tb_activity_log   : user_id 가 NULL 가능(SYSTEM 행위, 예: ingest 수신)이라 FK 없이 논리적 연계만.
' tb_role_permission: 역할(role) 문자열 기준 설정형 RBAC — FK 없음.
' tb_setting       : 전역 운영 설정(key-value). 어느 엔티티에도 매달리지 않는다.
' tb_compliance_snapshot : 그날의 findings/tb_host/tb_scan 을 읽어 판정한 결과의 스냅샷이라 원본 행과
'                     FK 로 묶지 않는다(원본이 지워져도 증적은 남아야 한다). 근거는 evidence JSON 에 담는다.
' tb_package_dependency : parent/child 는 값(manager+name+version)으로만 이어지는 자기참조라
'                     FK 를 걸 수 없다 — 자식이 tb_package 에 없을 수도 있다(전이 의존성).
' tb_schema_migrations : 마이그레이션 러너의 인프라 테이블 — 도메인 엔티티가 아니라 이 ERD 에서 제외.

@enduml
