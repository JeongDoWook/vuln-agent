@startuml erd
' vuln-agent §5 데이터 모델 (ERD)
' 원본: docs/dev/architecture.md §5 (mermaid erDiagram)
' 테이블별 전체 컬럼·책임·정규화 현황은 docs/dev/데이터베이스.md 참고.
'
' 표기: 감사 4컬럼(created_at/updated_at/is_deleted/deleted_at)은 모든 테이블에 통일되어 있으나
'      이 다이어그램엔 is_deleted 만 표기하고 나머지는 생략한다(mermaid 원본과 동일).
'
' 명명규칙: 테이블명은 단수, 대리키 PK 는 <단수 테이블명>_id, FK 는 부모 PK 이름을 그대로 쓴다
'          (tb_host.host_id ← tb_scan.host_id — 조인 양쪽 이름이 같다).
'          자연키·복합키·FK-as-PK 라 대리키를 두지 않는 예외(tb_cve/tb_kev_catalog 등)는
'          docs/dev/데이터베이스.md 의 예외표 참고.

hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
    BackgroundColor #ffffff
    BorderColor #6e7681
}

entity tb_host {
    host_id : bigint <<PK>>
    --
    fqdn : string <<UK>>
    os_id : string
    is_deleted : bool
}

entity tb_scan {
    scan_id : bigint <<PK>>
    --
    host_id : bigint <<FK>>
    collected_at : datetime
    package_count : int
    exposure_count : int
    is_deleted : bool
}

entity tb_package {
    package_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    container_id : bigint
    ' 호스트는 0, 컨테이너는 양수
    manager : string
    ' dpkg rpm apk pip npm
    name : string
    version : string
    source_pkg : string
    origin : string
    ' 출처 - 서드파티 판정
}

entity tb_container {
    container_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    cid : string
    image : string
    os_id : string
    manager : string
    ' dpkg apk rpm
    pkg_count : int
}

entity tb_stale_lib {
    stale_lib_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    comm : string
    ' 옛 so 를 문 프로세스
    package_name : string
    lib_path : string
}

entity tb_applied_errata {
    applied_errata_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    package_name : string
    cve_id : string
    evidence : string
    ' 권고가 지목한 설치 NEVRA
}

entity tb_debsecan {
    debsecan_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    cve_id : string
    package_name : string
}

entity tb_pkg_change {
    pkg_change_id : bigint <<PK>>
    --
    host_id : bigint <<FK>>
    scan_id : bigint <<FK>>
    package_name : string
    change_type : string
    ' installed removed upgraded downgraded
    old_version : string
    new_version : string
}

entity tb_exposure {
    exposure_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    proc : string
    port : int
    scope : string
    exe_pkg : string
    loaded_pkgs : text
}

entity tb_process {
    process_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    comm : string
    exe_pkg : string
    loaded_pkgs : text
}

entity tb_finding {
    finding_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    cve_id : string <<FK>>
    severity : string
    runtime_status : string
    in_kev : bool
}

entity tb_pkg_changelog_cve {
    pkg_changelog_cve_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    package_name : string
    cve_id : string
    evidence : string
}

entity tb_suppressed_finding {
    suppressed_finding_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    cve_id : string
    package_name : string
    base_severity : string
    suppress_reason : string
}

entity tb_cce_finding {
    cce_finding_id : bigint <<PK>>
    --
    scan_id : bigint <<FK>>
    code : string
    result : string
    severity : string
    rationale : string
}

entity tb_cve {
    cve_id : string <<PK>>
    ' 자연키 PK — 명명규칙 예외
    --
    cvss : decimal
    epss : decimal
    epss_percentile : decimal
    is_deleted : bool
}

entity tb_kev_catalog {
    cve_id : string <<PK>>
    ' FK-as-PK — 명명규칙 예외(대리키 없음)
    --
    date_added : date
}

entity tb_cve_affected_package {
    cve_affected_package_id : bigint <<PK>>
    --
    cve_id : string <<FK>>
    package_name : string
    fixed_version : string
}

entity tb_feed_connector {
    feed_connector_id : bigint <<PK>>
    --
    connector_type : string
    connection_json : json
    schedule_json : json
    enabled : bool
    next_run_at : datetime
    is_deleted : bool
}

entity tb_feed_collection_log {
    feed_collection_log_id : bigint <<PK>>
    --
    feed_connector_id : bigint <<FK>>
    status : string
    items_upserted : int
}

entity tb_advisory {
    advisory_id : bigint <<PK>>
    --
    source : string
    title : string
    url : string <<UK>>
    published : date
    cve_ids : string
    is_deleted : bool
}

entity tb_user {
    user_id : bigint <<PK>>
    --
    username : string <<UK>>
    password_hash : string
    role : string
    is_deleted : bool
}

entity tb_role_permission {
    role_permission_id : int <<PK>>
    --
    role : string
    menu_code : string
    allowed : bool
}

entity tb_api_token {
    api_token_id : bigint <<PK>>
    --
    label : string
    token_hash : string <<UK>>
    token_prefix : string
    last_used_at : datetime
    is_deleted : bool
}

entity tb_activity_log {
    activity_log_id : bigint <<PK>>
    --
    user_id : bigint
    scope : string
    scope_id : bigint
    activity_type : string
    data : json
    ip_address : string
    created_at : datetime
}

' ── 관계 ───────────────────────────────────────────────
tb_host ||--o{ tb_scan : "수집 이력"
tb_scan ||--o{ tb_package : "설치 패키지"
tb_scan ||--o{ tb_exposure : "노출 소켓(포트)"
tb_scan ||--o{ tb_process : "실행 프로세스"
tb_scan ||--o{ tb_finding : "매처 판정"
tb_scan ||--o{ tb_container : "컨테이너 인벤토리"
tb_container ||--o{ tb_package : "컨테이너 내부 패키지(container_id)"
tb_scan ||--o{ tb_pkg_changelog_cve : "억제 근거②"
tb_scan ||--o{ tb_applied_errata : "억제 근거③"
tb_scan ||--o{ tb_debsecan : "억제 근거④"
tb_scan ||--o{ tb_stale_lib : "억제 취소 — 재시작 필요"
tb_scan ||--o{ tb_suppressed_finding : "억제된 건"
tb_scan ||--o{ tb_cce_finding : "보안설정 점검"
tb_host ||--o{ tb_pkg_change : "패키지 변화 이력"
tb_cve ||--o{ tb_cve_affected_package : "영향 패키지"
tb_cve ||--o{ tb_finding : "취약점"
tb_cve ||--o| tb_kev_catalog : "KEV 등재"
tb_feed_connector ||--o{ tb_feed_collection_log : "수집 이력"
tb_user ||--o{ tb_activity_log : "행위 기록(느슨한 연계)"
tb_user ||--o{ tb_api_token : "발급(Export API)"

' ── FK 없는 테이블 (자연키 애플리케이션 조인) ──────────
' tb_advisory : CVE 와 느슨한 연계(제목의 CVE best-effort)라 FK 없음.
' tb_activity_log : user_id 가 NULL 가능(SYSTEM 행위, 예: ingest 수신)이라
'                   FK 없이 논리적 연계만 유지.
' tb_role_permission : 역할(role) 문자열 기준 설정형 RBAC — FK 없음.

@enduml
